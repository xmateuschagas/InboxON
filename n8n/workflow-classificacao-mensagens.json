{
  "id": "KodieMensagens01",
  "versionId": "d681fa28-ca91-4b87-84c5-3df7b8422068",
  "name": "KODIE | Classificação de mensagens",
  "active": false,
  "nodes": [
    {
      "id": "676245dd-8aa5-4e73-ae50-491cb4c1a49c",
      "webhookId": "594307a3-acd5-448a-9d07-92ad337a390c",
      "name": "Receber mensagem",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 160],
      "parameters": { "httpMethod": "POST", "path": "classificar-mensagem", "responseMode": "responseNode", "options": {} }
    },
    {
      "id": "dad9c527-5b7c-40ce-b604-10c0ed3672ed",
      "name": "Classificar na API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 160],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/classificacoes",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body ?? {}) }}",
        "options": {
          "response": { "response": { "fullResponse": true, "neverError": true, "responseFormat": "json" } },
          "timeout": 50000
        }
      }
    },
    {
      "id": "205de009-1b47-409c-a4f9-6d51f5b29ed5",
      "name": "Classificação recebida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 160],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "85f10440-a142-40ce-a5f5-51cb275d0e8d",
              "leftValue": "={{ $json.statusCode === 200 && Boolean($json.body?.id && $json.body?.classificacao) }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9bd53778-4815-4af9-88e9-df59a1aa2a57",
      "name": "Definir fila",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 40],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ (() => {\n  const { id, origem, classificacao } = $json.body;\n  let fila = classificacao.setor_sugerido;\n  if (origem === 'fallback') fila = 'triagem';\n  else if (classificacao.prioridade === 'alta') fila = 'prioritario';\n  else if (classificacao.categoria === 'outro') fila = 'triagem';\n  return { id, origem, classificacao, fila, mensagem: $('Receber mensagem').first().json.body.mensagem };\n})() }}",
        "options": {}
      }
    },
    {
      "id": "935d5768-66a5-4eba-82db-394a5c44401b",
      "name": "Registrar encaminhamento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 40],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/encaminhamentos",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "response": { "response": { "fullResponse": true, "neverError": true, "responseFormat": "json" } },
          "timeout": 8000
        }
      }
    },
    {
      "id": "5fdb4c3d-85e1-4996-8c02-14974920dc6a",
      "name": "Responder webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1200, 160],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify((($json.statusCode === 200 || $json.statusCode === 201) && $json.body?.fila) || ($json.statusCode === 422 && $json.body?.erro === 'entrada_invalida' && !$('Registrar encaminhamento').isExecuted) ? $json.body : { erro: 'falha_na_automacao' }) }}",
        "options": {
          "responseCode": "={{ ($json.statusCode === 200 || $json.statusCode === 201) && $json.body?.fila ? $json.statusCode : $json.statusCode === 422 && $json.body?.erro === 'entrada_invalida' && !$('Registrar encaminhamento').isExecuted ? 422 : 502 }}"
        }
      }
    }
  ],
  "connections": {
    "Receber mensagem": { "main": [[{ "node": "Classificar na API", "type": "main", "index": 0 }]] },
    "Classificar na API": { "main": [[{ "node": "Classificação recebida?", "type": "main", "index": 0 }]] },
    "Classificação recebida?": {
      "main": [
        [{ "node": "Definir fila", "type": "main", "index": 0 }],
        [{ "node": "Responder webhook", "type": "main", "index": 0 }]
      ]
    },
    "Definir fila": { "main": [[{ "node": "Registrar encaminhamento", "type": "main", "index": 0 }]] },
    "Registrar encaminhamento": { "main": [[{ "node": "Responder webhook", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveDataSuccessExecution": "all", "saveManualExecutions": true },
  "pinData": {},
  "tags": []
}
